name: Kozmik Sayi APK Olustur

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Kodlari Cek
        uses: actions/checkout@v4

      - name: Java 17 Kur
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Gradle Hazirla ve APK Derle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'
          arguments: assembleDebug

      - name: APK Dosyasini Indirmeye Ac
        uses: actions/upload-artifact@v4
        with:
          name: kozmik-sayi-apk
          path: app/build/outputs/apk/debug/app-debug.apk
